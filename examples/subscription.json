{
  "apiVersion": "nidl.io/v1",
  "kind": "Subscription",
  "metadata": {"name": "atlanta-harq-watch"},
  "spec": {
    "workflowRef": "ran-harq-degradation@1.0.0",
    "scope": {"market": "atlanta"},
    "parameters": {"min_users": 100},
    "evaluation": {"every": "5m", "freshness": "15m"},
    "notification": {
      "channels": ["inbox"],
      "policyRef": "adaptive-incident-v1",
      "materialChange": {"affectedUsersIncreasePct": 30},
      "stableBackoff": ["15m", "30m", "1h", "4h"]
    },
    "okfBundleRef": "ran-harq-watch@1",
    "ai": {"mode": "conditional", "investigationRecipe": "cross-domain-rca@1", "maxToolCalls": 8}
  }
}
